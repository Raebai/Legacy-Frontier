# Legacy Frontier — environment variables template
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Local LLM (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Future: Twitch integration for viewer-named NPCs (Tier 7) ---
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_OAUTH_TOKEN=
# TWITCH_CHANNEL=

# --- Future: multiplayer server (Tier 4) ---
# SERVER_HOST=
# SERVER_PORT=
# SERVER_AUTH_KEY=

# --- Future: telemetry / crash reporting ---
# SENTRY_DSN=
# ANALYTICS_KEY=

# --- Local dev flags ---
DEV_MODE=true
LOG_LEVEL=info
