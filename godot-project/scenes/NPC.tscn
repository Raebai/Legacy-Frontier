[gd_scene load_steps=6 format=3]

; ONE TOWNSPERSON. World.gd instances this once per entry in World.TOWNSFOLK and
; swaps `data` for that person's .tres.
;
; The `ConsolidatorHTTP` HTTPRequest child is gone: it POSTed the NPC's whole
; transcript to a local Ollama server for a 3B model to summarise into a memory
; file. That stack is deleted — see the header of NPC.gd.

[ext_resource type="Script" path="res://scripts/NPC.gd" id="1_npc_script"]
[ext_resource type="Resource" path="res://data/npcs/doorkeeper.tres" id="2_npc_data"]
[ext_resource type="PackedScene" path="res://scenes/SpeechBubble.tscn" id="3_speech_bubble"]

[sub_resource type="RectangleShape2D" id="RectangleShape2D_npc_body"]
size = Vector2(16, 16)

[sub_resource type="CircleShape2D" id="CircleShape2D_npc_proximity"]
radius = 40.0

; ⚠ A CharacterBody2D, NOT A StaticBody2D, AND ON LAYER 2. Maker: "make all the other
; stickmen in the hub the same as mine in terms of ragdoll walking physics". A
; townsperson used to be teleported along x by writing `global_position`, which meant
; its rig was fed a SYNTHESISED velocity and never knew about gravity, landing or the
; floor. It runs the same `move_and_slide` the player does now.
;
; Layer 2 (the fighter layer) rather than 1 matters for a measured reason: layer 1 is
; `CharacterRig.GROUND_MASK`, so a townsperson on it is FLOOR to every rig's downward
; probe — `probe_town_feet` caught a practice dummy reading its ground line off the
; Warden's head, 16 px above the actual floor.
; ⚠ AND THE LAYER MUST BE A PROPERTY LINE, NOT AN ATTRIBUTE IN THE HEADER. It was
; written as `[node ... collision_layer="2" collision_mask="1" ...]`, where Godot's
; scene parser SILENTLY IGNORES it — only `name`, `type`, `parent`, `groups`, `index`
; and `instance` are header attributes. So every townsperson shipped on the DEFAULT
; layer 1, which is exactly the `GROUND_MASK` the comment above says to stay off, and
; each one's own rig read its own 16 px collider as the floor: measured leg length
; 0.09 px on the Warden, 0.16 px on the Doorkeeper, against the Hero's 16.0. That is
; the "the Warden is all messed up" report — a head, a torso, arms and no legs.
; NPC.tscn was the only scene in the repo with this mistake.
[node name="NPC" type="CharacterBody2D" groups=["npc"]]
collision_layer = 2
collision_mask = 1
script = ExtResource("1_npc_script")
data = ExtResource("2_npc_data")

[node name="Visual" type="ColorRect" parent="."]
offset_left = -8.0
offset_top = -8.0
offset_right = 8.0
offset_bottom = 8.0
color = Color(0.95, 0.5, 0.2, 1)

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
position = Vector2(0, -8)
shape = SubResource("RectangleShape2D_npc_body")

[node name="ProximityArea" type="Area2D" parent="."]
position = Vector2(0, -14)
; MASK 1 AND 2. The town body is a Hero (collision layer 2) since casting moved into
; the lobby; the default mask of 1 stopped seeing it, so townsfolk went silent.
collision_mask = 3

[node name="ProximityShape" type="CollisionShape2D" parent="ProximityArea"]
shape = SubResource("CircleShape2D_npc_proximity")

[node name="HintLabel" type="Label" parent="."]
visible = false
offset_left = -52.0
offset_top = -62.0
offset_right = 52.0
offset_bottom = -46.0
theme_override_colors/font_outline_color = Color(0.05, 0.05, 0.1, 0.9)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 12
text = "[E] Talk"
horizontal_alignment = 1

[node name="SpeechBubble" parent="." instance=ExtResource("3_speech_bubble")]
