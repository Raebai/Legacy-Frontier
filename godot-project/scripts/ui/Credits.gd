func _ready() -> void:
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	# Eat taps so a stray press does not hit the lobby button underneath.
	mouse_filter = Control.MOUSE_FILTER_STOP

	var dim := ColorRect.new()
	dim.color = Color(0.03, 0.03, 0.05, 0.94)
	dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	add_child(dim)

	var margin := MarginContainer.new()
	margin.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	for side: String in ["left", "right"]:
		margin.add_theme_constant_override("margin_" + side, 26)
	margin.add_theme_constant_override("margin_top", 10)
	margin.add_theme_constant_override("margin_bottom", 8)
	add_child(margin)

	var col := VBoxContainer.new()
	col.add_theme_constant_override("separation", 4)
	margin.add_child(col)

	var title := Label.new()
	title.text = "CREDITS"
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_size_override("font_size", TITLE_SIZE)
	title.add_theme_color_override("font_color", CHALK)
	col.add_child(title)

	# A ScrollContainer, because the roll is longer than 360 px and a phone in
	# landscape has none of it spare. Touch drag scrolls it for free.
	var scroll := ScrollContainer.new()
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	col.add_child(scroll)

	var roll := VBoxContainer.new()
	roll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	roll.add_theme_constant_override("separation", 2)
	scroll.add_child(roll)
	for entry: Array in ROLL:
		roll.add_child(_row(String(entry[0]), String(entry[1])))

	var back := Button.new()
	back.text = "Back"
	# ⚠ 30 -> 46 px tall. This is the ONLY control on the credits screen — the one way
	# back out of it — and at 30 px it was a 5.5 mm target on a 6.1" phone. Width stays
	# 160: it is already 29 mm, and a wide short button is missed on the axis that is
	# short. See `PauseMenu.ROW_H` for the conversion.
	back.custom_minimum_size = Vector2(160, 46)
	back.add_theme_font_size_override("font_size", 14)
	back.focus_mode = Control.FOCUS_NONE
	back.pressed.connect(close)
	var back_row := HBoxContainer.new()
	back_row.alignment = BoxContainer.ALIGNMENT_CENTER
	back_row.add_child(back)
	col.add_child(back_row)


func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("ui_cancel"):
		get_viewport().set_input_as_handled()
		close()


## Emit and let the owner dispose of us. When this scene IS the root (run on its
## own), there is nobody listening, so it walks back to the Lobby itself.
func close() -> void:
	closed.emit()
	if get_tree() != null and get_tree().current_scene == self:
		get_tree().change_scene_to_file("res://scenes/ui/Lobby.tscn")


func _row(kind: String, text: String) -> Control:
	if text.is_empty():
		var pad := Control.new()
		pad.custom_minimum_size = Vector2(0, 8)
		return pad
	var l := Label.new()
	l.text = text
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	match kind:
		"head":
			l.text = text
			l.add_theme_font_size_override("font_size", HEAD_SIZE)
			l.add_theme_color_override("font_color", HEAD_COLOR)
		"warn":
			l.text = "⚠  " + text
			l.add_theme_font_size_override("font_size", BODY_SIZE)
			l.add_theme_color_override("font_color", WARN_COLOR)
		"note":
			l.add_theme_font_size_override("font_size", BODY_SIZE - 1)
			l.add_theme_color_override("font_color", GRAPHITE)
		_:
			l.add_theme_font_size_override("font_size", BODY_SIZE)
			l.add_theme_color_override("font_color", CHALK)
	return l
