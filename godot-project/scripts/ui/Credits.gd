extends Control
## CREDITS — and this screen is a LICENSING OBLIGATION, not a courtesy.
##
## `assets/audio/CREDITS.md` §1c records that the **Pepper Sound Pack** (Keisan /
## Fabien Boulanger) ships with a readme that asks, in writing, for credit:
##
##   > "Thanks for crediting Pepper if this pack serves you in your videos."
##
## That pack is under every melee swing, punch, kick, block, guard break, hero
## hurt, body fall, gib, dash and footstep in the game. The attribution below is
## the only thing the licence asks for, and it is free — so it is not optional,
## and it must not be quietly dropped by a future layout tidy. `PEPPER_LINE` is
## asserted verbatim by `tools/slice_test_credits.gd` for exactly that reason.
##
## Everything else here is voluntary. The Sonniss #GameAudioGDC bundle is
## explicitly royalty-free WITHOUT attribution and the OpenGameArt material is
## CC0, but the contributors are named anyway because it costs a scroll and it is
## the decent thing.
##
## ⚠ TWO PROVENANCE GAPS ARE STATED HERE RATHER THAN HIDDEN — see the "unsettled"
## section at the bottom of the roll. They are pre-existing, they are the maker's
## call, and a credits screen that pretends they do not exist is worse than one
## that says so.
##
## Reachable from the Lobby as an OVERLAY (so hosting a lobby and reading the
## credits does not drop the peer you were waiting for), and runnable as a scene
## on its own. Escape or the Back button closes it. Nothing here pauses the game.

signal closed

const TITLE_SIZE: int = 22
const HEAD_SIZE: int = 13
const BODY_SIZE: int = 11

const CHALK: Color = Color(0.93, 0.92, 0.86)
const GRAPHITE: Color = Color(0.66, 0.67, 0.74)
const HEAD_COLOR: Color = Color(0.62, 0.86, 1.0)
const WARN_COLOR: Color = Color(0.98, 0.76, 0.42)

## THE LINE THE LICENCE ASKS FOR. Do not reword, do not abbreviate, do not move
## it below the fold. Pinned by the test suite.
const PEPPER_LINE: String = "Pepper Sound Pack — Keisan (Fabien Boulanger)"

## The roll. Each entry is [kind, text]:
##   "head" — a section heading
##   "line" — a normal credit line
##   "note" — dimmer, smaller supporting text
##   "warn" — an unsettled licence the maker needs to look at
const ROLL: Array = [
	["head", "THE TOWER"],
	["note", "an unseen hand draws the floor, the mobs and the boss."],
